# ── Database ──────────────────────────────────────────────
POSTGRES_USER=cvats
POSTGRES_PASSWORD=cvats_dev_password
POSTGRES_DB=cv_ats_scanner
DATABASE_URL=postgresql+asyncpg://cvats:cvats_dev_password@localhost:5432/cv_ats_scanner

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=cv-ats-files
S3_REGION=us-east-1

# ── Backend ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
DEBUG=true
SYNC_TASKS=true

